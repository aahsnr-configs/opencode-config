{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "chat",
  "websearch": {
    "provider": "exa",
  },
  "agents": {
    "plan": {
      "permissions": [
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny",
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny",
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "ask",
        },
      ],
    },
  },
  "update": "notify",
  "share": "disabled",
  "snapshots": true,
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "opencode-rtk-plugin",
    "opencode-openwork@0.1.0",
    "opencode-todo",
    "/var/home/ahsan/.config/opencode/plugins/caveman",
    {
      "package": "@plannotator/opencode@latest",
      "options": {
        "workflow": "plan-agent",
        "planningAgents": [
          "plan"
        ],
      },
    },
  ],
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 8000,
    },
    "buffer": "15%",
  },
  "tool_output": {
    "max_lines": 300,
    "max_bytes": 16000,
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "ask",
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow",
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny",
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny",
    },
    {
      "action": "read",
      "resource": "*.pem",
      "effect": "deny",
    },
    {
      "action": "read",
      "resource": "*.key",
      "effect": "deny",
    },
    {
      "action": "read",
      "resource": "*/.ssh/*",
      "effect": "deny",
    },
    {
      "action": "read",
      "resource": "*/.aws/*",
      "effect": "deny",
    },
    {
      "action": "read",
      "resource": "*/.config/*/auth.json",
      "effect": "deny",
    },
    {
      "action": "read",
      "resource": "*auth.json",
      "effect": "deny",
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow",
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow",
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow",
    },
    {
      "action": "question",
      "resource": "*",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask",
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "ask",
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask",
    },
    {
      "action": "shell",
      "resource": "git status *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "git diff *",
      "effect": "ask",
    },
    {
      "action": "shell",
      "resource": "git log *",
      "effect": "ask",
    },
    {
      "action": "shell",
      "resource": "git diff --stat",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "git diff --name-only",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "git log --oneline -10",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "deny",
    },
    {
      "action": "shell",
      "resource": "git push --*",
      "effect": "deny",
    },
    {
      "action": "shell",
      "resource": "rm -rf *",
      "effect": "deny",
    },
    {
      "action": "subagent",
      "resource": "*",
      "effect": "ask",
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "ask",
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "ask",
    },
    {
      "action": "execute",
      "resource": "*",
      "effect": "ask",
    },
    {
      "action": "context7_*",
      "resource": "*",
      "effect": "ask",
    },
    {
      "action": "exa_*",
      "resource": "*",
      "effect": "ask",
    },
    {
      "action": "consensus_*",
      "resource": "*",
      "effect": "ask",
    },
    {
      "action": "alphaxiv_*",
      "resource": "*",
      "effect": "ask",
    },
    {
      "action": "undermind_*",
      "resource": "*",
      "effect": "ask",
    },
    {
      "action": "tamarind_*",
      "resource": "*",
      "effect": "ask",
    },
    {
      "action": "github_*",
      "resource": "*",
      "effect": "ask",
    },
    {
      "action": "ticktick_*",
      "resource": "*",
      "effect": "ask",
    },
    {
      "action": "playwright_*",
      "resource": "*",
      "effect": "ask",
    },
    {
      "action": "opencode_list_mcp_resources",
      "resource": "*",
      "effect": "ask",
    },
    {
      "action": "opencode_read_mcp_resource",
      "resource": "*",
      "effect": "ask",
    },
    {
      "action": "zotero_*",
      "resource": "*",
      "effect": "ask",
    },
  ],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "disabled": true,
        "codemode": false,
      },
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa,agent_run",
        "disabled": true,
        "codemode": false,
      },
      "consensus": {
        "type": "remote",
        "url": "https://mcp.consensus.app/mcp",
        "disabled": true,
        "codemode": false,
      },
      "alphaxiv": {
        "type": "remote",
        "url": "https://api.alphaxiv.org/mcp/v1",
        "disabled": true,
        "codemode": false,
      },
      "undermind": {
        "type": "remote",
        "url": "https://mcp.undermind.ai/mcp",
        "disabled": true,
        "codemode": false,
      },
      "tamarind": {
        "type": "remote",
        "url": "https://mcp.tamarind.bio/mcp",
        "disabled": true,
        "protocol": "auto",
        "codemode": false,
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/readonly",
        "disabled": true,
        "codemode": false,
      },
      "ticktick": {
        "type": "remote",
        "url": "https://mcp.ticktick.com",
        "disabled": true,
        "codemode": false,
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp",
          "--headless",
          "--isolated"
        ],
        "disabled": true,
        "codemode": false,
      },
      "zotero": {
        "type": "local",
        "command": [
          "opencode-research-tools",
          "serve-zotero"
        ],
        "disabled": true,
        "codemode": false,
      },
    },
  },
  "policies": [
    {
      "action": "mcp.use",
      "resource": "*",
      "effect": "deny",
    },
    {
      "action": "mcp.use",
      "resource": "context7",
      "effect": "allow",
    },
    {
      "action": "mcp.use",
      "resource": "exa",
      "effect": "allow",
    },
    {
      "action": "mcp.use",
      "resource": "consensus",
      "effect": "allow",
    },
    {
      "action": "mcp.use",
      "resource": "alphaxiv",
      "effect": "allow",
    },
    {
      "action": "mcp.use",
      "resource": "undermind",
      "effect": "allow",
    },
    {
      "action": "mcp.use",
      "resource": "tamarind",
      "effect": "allow",
    },
    {
      "action": "mcp.use",
      "resource": "github",
      "effect": "allow",
    },
    {
      "action": "mcp.use",
      "resource": "ticktick",
      "effect": "allow",
    },
    {
      "action": "mcp.use",
      "resource": "playwright",
      "effect": "allow",
    },
    {
      "action": "mcp.use",
      "resource": "zotero",
      "effect": "allow",
    },
  ],
}
